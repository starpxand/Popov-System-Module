{
  "метаданные_системы": {
    "идентификатор_модуля": "semantic-navigator-pro",
    "название": "Система визуализации и навигации по семантическому графу",
    "версия_протокола": "2.0.0",
    "описание_задачи": "Поиск кратчайших путей, детекция циклов и генерация Graphviz-кода"
  },
  "входные_параметры (INPUT)": {
    "данные_запроса": {
      "текст_из_поисковой_строки": "string (то, что ввел пользователь в Search Bar)",
      "идентификатор_начала": "string (ID узла, откуда стартуем, например: 'узел_студент')",
      "идентификатор_цели": "string (ID узла финиша, например: 'узел_приказ')"
    },
    "технические_ограничения": {
      "глубина_рекурсии": "integer (параметр Depth из сценария 2: 1, 2 или 3)",
      "строгий_режим": "boolean (если true, ошибка при любом цикле)",
      "язык_вывода": "string (по умолчанию 'ru')"
    },
    "настройки_интерфейса": {
      "отображать_людей": "boolean (состояние чекбокса 1)",
      "отображать_даты": "boolean (состояние чекбокса 2)",
      "скрыть_тех_узлы": "boolean (состояние чекбокса 3)"
    }
  },
  "исходящие_параметры (OUTPUT)": {
    "статус_выполнения": {
      "код_состояния": "integer (200 - успех, 404 - путь не найден, 500 - ошибка цикла)",
      "сообщение": "string (текстовое пояснение, например: 'Путь успешно построен')"
    },
    "навигационные_данные": {
      "путь_существует": "boolean (найден ли маршрут до цели)",
      "длина_найденного_пути": "integer (количество шагов между узлами)",
      "список_вершин_маршрута": "array of strings (полная цепочка: ['Студент', 'Деканат', 'Приказ'])",
      "информация_о_циклах": {
        "цикл_обнаружен": "boolean (флаг для Сценария 6)",
        "описание_цикла": "string (например: 'Студент -> Долг -> Студент')"
      }
    },
    "графические_данные": {
      "формат_визуализации": "string (Graphviz DOT)",
      "код_для_отрисовки": "string (готовый блок digraph G { ... } из Сценария 4)",
      "таблица_смежности": [
        {
          "вершина": "string (имя соседа)",
          "тип_связи": "string (отношение из Сценария 5)",
          "вес_связи": "float (важность или расстояние)"
        }
      ]
    },
    "аналитика_поиска": {
      "всего_обработано_узлов": "integer (статистика из Сценария 2)",
      "затраченная_память_кб": "float",
      "время_работы_микросекунды": "integer"
    }
  }
}